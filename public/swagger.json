{
  "openapi": "3.0.0",
  "info": {
    "title": "Sacrament Meetings API",
    "version": "1.0.0",
    "description": "API for sacrament meeting agendas."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "components": {
    "schemas": {
      "Hymn": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "HymnInput": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "Hymn number; cannot be changed after creation."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      },
      "HymnResponse": {
        "type": "object",
        "required": [
          "statusCode",
          "message",
          "data",
          "errors"
        ],
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/Hymn"
          },
          "errors": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/ApiResponseError"
            }
          }
        }
      },
      "HymnListResponse": {
        "type": "object",
        "required": [
          "statusCode",
          "message",
          "data",
          "errors"
        ],
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Hymn"
            }
          },
          "errors": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/ApiResponseError"
            }
          }
        }
      },
      "SpeakerItem": {
        "type": "object",
        "required": [
          "name",
          "topic"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          }
        }
      },
      "WardBusinessItem": {
        "type": "object",
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "type": "string"
          }
        }
      },
      "SacramentMeeting": {
        "type": "object",
        "required": [
          "id",
          "date",
          "meeting_type",
          "presiding",
          "conducting",
          "opening_hymn",
          "opening_prayer",
          "ward_business",
          "stake_business",
          "sacrament_hymn",
          "speakers",
          "closing_hymn",
          "closing_prayer"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "meeting_type": {
            "type": "string",
            "enum": [
              "testimony",
              "regular",
              "stake",
              "general"
            ]
          },
          "presiding": {
            "type": "string"
          },
          "conducting": {
            "type": "string"
          },
          "announcements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "opening_hymn": {
            "$ref": "#/components/schemas/Hymn"
          },
          "opening_prayer": {
            "type": "string"
          },
          "ward_business": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WardBusinessItem"
            }
          },
          "stake_business": {
            "type": "boolean"
          },
          "sacrament_hymn": {
            "$ref": "#/components/schemas/Hymn"
          },
          "intermediate_hymn": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Hymn"
              }
            ],
            "nullable": true
          },
          "musical_numbers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Hymn"
            }
          },
          "speakers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpeakerItem"
            }
          },
          "closing_hymn": {
            "$ref": "#/components/schemas/Hymn"
          },
          "closing_prayer": {
            "type": "string"
          }
        }
      },
      "MeetingInput": {
        "type": "object",
        "required": [
          "date",
          "meeting_type",
          "presiding",
          "conducting",
          "opening_hymn_id",
          "opening_prayer",
          "ward_business",
          "stake_business",
          "sacrament_hymn_id",
          "speakers",
          "closing_hymn_id",
          "closing_prayer"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "meeting_type": {
            "type": "string",
            "enum": [
              "testimony",
              "regular",
              "stake",
              "general"
            ]
          },
          "presiding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "conducting": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "announcements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "opening_hymn_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Hymn database ID."
          },
          "opening_prayer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "ward_business": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WardBusinessItem"
            }
          },
          "stake_business": {
            "type": "boolean"
          },
          "sacrament_hymn_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Hymn database ID."
          },
          "intermediate_hymn_id": {
            "type": "integer",
            "minimum": 1,
            "nullable": true,
            "description": "Optional hymn database ID."
          },
          "musical_number_ids": {
            "type": "array",
            "description": "Hymn database IDs.",
            "maxItems": 30,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "speakers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpeakerItem"
            }
          },
          "closing_hymn_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Hymn database ID."
          },
          "closing_prayer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      },
      "ApiFieldError": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ApiResponseError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiFieldError"
            }
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "required": [
          "statusCode",
          "message",
          "data",
          "errors"
        ],
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "nullable": true
          },
          "errors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ApiResponseError"
            }
          }
        }
      },
      "MeetingResponse": {
        "type": "object",
        "required": [
          "statusCode",
          "message",
          "data",
          "errors"
        ],
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SacramentMeeting"
              }
            ]
          },
          "errors": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/ApiResponseError"
            }
          }
        }
      },
      "PaginatedMeetings": {
        "type": "object",
        "required": [
          "statusCode",
          "message",
          "data",
          "errors"
        ],
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "meetings",
              "query",
              "sort",
              "pagination"
            ],
            "properties": {
              "meetings": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SacramentMeeting"
                }
              },
              "query": {
                "type": "object",
                "description": "Search filter applied to the meeting list, or an empty object when no search was provided.",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              },
              "sort": {
                "type": "object",
                "description": "Meetings are ordered by date, newest first.",
                "required": [
                  "field",
                  "order"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "enum": [
                      "date"
                    ]
                  },
                  "order": {
                    "type": "string",
                    "enum": [
                      "desc"
                    ]
                  }
                }
              },
              "pagination": {
                "type": "object",
                "required": [
                  "page",
                  "limit",
                  "totalItems",
                  "startItem",
                  "endItem",
                  "totalPages",
                  "hasNextPage",
                  "hasPreviousPage",
                  "totalMeetings"
                ],
                "properties": {
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  },
                  "totalItems": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Number of meetings matching the search."
                  },
                  "startItem": {
                    "type": "integer",
                    "minimum": 0,
                    "example": 1,
                    "description": "Position of the first meeting on this page, or 0 if the page is empty."
                  },
                  "endItem": {
                    "type": "integer",
                    "minimum": 0,
                    "example": 6,
                    "description": "Position of the last meeting on this page, or 0 if the page is empty."
                  },
                  "totalPages": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "hasNextPage": {
                    "type": "boolean"
                  },
                  "hasPreviousPage": {
                    "type": "boolean"
                  },
                  "totalMeetings": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Total number of meetings, before search filtering."
                  }
                }
              }
            }
          },
          "errors": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/ApiResponseError"
            }
          }
        }
      },
      "MeetingByDate": {
        "type": "object",
        "required": [
          "statusCode",
          "message",
          "data",
          "errors"
        ],
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SacramentMeeting"
              }
            ]
          },
          "errors": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/ApiResponseError"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/meetings": {
      "get": {
        "tags": [
          "Meetings"
        ],
        "summary": "Get paginated meetings or a meeting by date",
        "description": "When date is provided, page, limit, and query are ignored. Otherwise, results are ordered by date descending.",
        "parameters": [
          {
            "in": "query",
            "name": "date",
            "description": "Find the meeting for this calendar date in YYYY-MM-DD format.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "query",
            "description": "Case-insensitive partial match across meeting details.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "description": "Page number for the filtered meeting list (default is 1).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "description": "Number of meetings per page (default is 6, maximum is 50).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 6
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated meeting list, or the meeting for the requested date."
          },
          "400": {
            "description": "Invalid date, page, or limit."
          },
          "404": {
            "description": "No meeting exists for the requested date."
          },
          "500": {
            "description": "The meeting data could not be retrieved."
          }
        }
      },
      "post": {
        "tags": [
          "Meetings"
        ],
        "summary": "Create a meeting",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeetingInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Meeting created."
          },
          "400": {
            "description": "Invalid JSON or meeting data."
          },
          "409": {
            "description": "A meeting already exists for the requested date."
          },
          "415": {
            "description": "The request must use application/json."
          },
          "500": {
            "description": "The meeting could not be created."
          }
        }
      }
    },
    "/api/meetings/{id}": {
      "get": {
        "tags": [
          "Meetings"
        ],
        "summary": "Get a meeting by ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Meeting ID as a whole number.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested meeting."
          },
          "400": {
            "description": "Invalid meeting ID."
          },
          "404": {
            "description": "No meeting exists for the requested ID."
          },
          "500": {
            "description": "The meeting data could not be retrieved."
          }
        }
      },
      "put": {
        "tags": [
          "Meetings"
        ],
        "summary": "Replace a meeting by ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeetingInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Meeting updated."
          },
          "400": {
            "description": "Invalid meeting ID, JSON, or meeting data."
          },
          "404": {
            "description": "No meeting exists for the requested ID."
          },
          "409": {
            "description": "A meeting already exists for the requested date."
          },
          "415": {
            "description": "The request must use application/json."
          },
          "500": {
            "description": "The meeting could not be updated."
          }
        }
      },
      "delete": {
        "tags": [
          "Meetings"
        ],
        "summary": "Delete a meeting by ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meeting deleted; the response data contains the deleted meeting."
          },
          "400": {
            "description": "Invalid meeting ID."
          },
          "404": {
            "description": "No meeting exists for the requested ID."
          },
          "500": {
            "description": "The meeting could not be deleted."
          }
        }
      }
    },
    "/api/hymns": {
      "get": {
        "tags": [
          "Hymns"
        ],
        "summary": "Get hymns or search by ID/title",
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "description": "Look up a single hymn by ID. Do not combine with title or query.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "title",
            "description": "Look up a single hymn by its case-insensitive title.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "query",
            "description": "Filter the hymn list by ID or title.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hymn or hymn list retrieved."
          },
          "400": {
            "description": "Invalid hymn search."
          },
          "404": {
            "description": "Hymn not found."
          },
          "500": {
            "description": "Hymn retrieval failed."
          }
        }
      },
      "post": {
        "tags": [
          "Hymns"
        ],
        "summary": "Create a hymn",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HymnInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Hymn created."
          },
          "400": {
            "description": "Invalid JSON or hymn data."
          },
          "409": {
            "description": "Duplicate hymn ID or title."
          },
          "415": {
            "description": "Expected application/json."
          },
          "500": {
            "description": "Hymn creation failed."
          }
        }
      }
    },
    "/api/hymns/{id}": {
      "get": {
        "tags": [
          "Hymns"
        ],
        "summary": "Get a hymn by ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hymn retrieved."
          },
          "400": {
            "description": "Invalid hymn ID"
          },
          "404": {
            "description": "Hymn not found"
          },
          "500": {
            "description": "Hymn retrieval failed"
          }
        }
      },
      "put": {
        "tags": [
          "Hymns"
        ],
        "summary": "Replace a hymn by ID",
        "description": "The request ID must match the ID in the URL.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HymnInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hymn updated."
          },
          "400": {
            "description": "Invalid hymn ID",
            "JSON": null,
            "or hymn data": null
          },
          "404": {
            "description": "Hymn not found"
          },
          "409": {
            "description": "Duplicate hymn title"
          },
          "415": {
            "description": "Expected application/json"
          },
          "500": {
            "description": "Hymn update failed"
          }
        }
      },
      "delete": {
        "tags": [
          "Hymns"
        ],
        "summary": "Delete a hymn by ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted hymn."
          },
          "400": {
            "description": "Invalid hymn ID"
          },
          "404": {
            "description": "Hymn not found"
          },
          "409": {
            "description": "Hymn is used by a meeting"
          },
          "500": {
            "description": "Hymn deletion failed"
          }
        }
      }
    }
  },
  "tags": []
}
